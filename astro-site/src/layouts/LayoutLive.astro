---
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/500.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/teko/400.css';
import '@fontsource/teko/500.css';
import '@fontsource/teko/600.css';
import '../styles/bootstrap.min.css';
import '../styles/style.css';
import '../styles/theme-dark.css';
import HeaderLive from '../components/HeaderLive.astro';
import FooterLive from '../components/FooterLive.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  chat?: boolean;
  carousel?: boolean;
  activePage?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  keywords,
  ogTitle,
  ogDescription,
  ogUrl,
  ogImage,
  chat = true,
  carousel = false,
  activePage,
  robots
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{title}</title>

    <!-- Theme Detection (Dark default / Persisted in localStorage) -->
    <script is:inline>
        (function() {
            try {
                var params = new URLSearchParams(window.location.search);
                var themeParam = params.get('theme');
                var storedTheme = localStorage.getItem('op_theme');
                
                if (themeParam === 'light') {
                    localStorage.setItem('op_theme', 'light');
                    document.documentElement.removeAttribute('data-theme');
                } else if (themeParam === 'dark') {
                    localStorage.setItem('op_theme', 'dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else if (storedTheme === 'light') {
                    document.documentElement.removeAttribute('data-theme');
                } else {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>
    
    <!-- Meta SEO -->
    <meta name="author" content="Opportunity Painting &amp; Renovation Services Inc.">
    <meta property="og:site_name" content="Opportunity Painting &amp; Renovation Services Inc.">
    {robots && <meta name="robots" content={robots}>}
    {keywords && <meta name="keywords" content={keywords}>}
    <meta name="description" content={description}>
    {canonical && <link rel="canonical" href={canonical}>}
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={ogTitle || title}>
    <meta property="og:description" content={ogDescription || description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={ogUrl || canonical || (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : "https://smtfyweb.github.io/appt/")}>
    <meta property="og:image" content={ogImage || (Astro.site ? new URL('/img/carousel-3.jpg', Astro.site).toString() : "https://smtfyweb.github.io/appt/img/carousel-3.jpg")}>

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle || title}>
    <meta name="twitter:description" content={ogDescription || description}>
    <meta name="twitter:image" content={ogImage || (Astro.site ? new URL('/img/carousel-3.jpg', Astro.site).toString() : "https://smtfyweb.github.io/appt/img/carousel-3.jpg")}>


    <slot name="jsonld" />

    <!-- Favicon -->
    <link rel="icon" href="data:,">

    {activePage === 'home' && (
    <link rel="preload" as="image" href="/img/carousel-3.jpg" fetchpriority="high">
    )}

    <!-- Preconnect for Third Party Performance -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://cdn.leadster.com.br" crossorigin>

    <!-- CSS Libraries -->
    <link rel="stylesheet" href="/css/animate-lite.css">
    {carousel && (
    <link rel="stylesheet" href="/lib/owlcarousel/assets/owl.carousel.min.css">
    )}

    <!-- Global DataLayer & Deferred Analytics/Chat Loader -->
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        function initTrackingAndChat() {
            if (window._trackingAndChatLoaded) return;
            window._trackingAndChatLoaded = true;

            // 1. Google Tag Manager
            try {
                (function(w, d, s, l, i) {
                    w[l] = w[l] || [];
                    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                    var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
                    j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                    f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-N64XLKBT');
            } catch (e) {}

            // 2. Google Ads gtag
            try {
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-393984382';
                document.head.appendChild(s);
                gtag('config', 'AW-393984382');
            } catch (e) {}

            // 3. Leadster Chat
            try {
                var c = document.createElement('script');
                c.src = 'https://cdn.leadster.com.br/neurolead/neurolead.min.js';
                c.charset = 'UTF-8';
                c.defer = true;
                window.neuroleadId = '5S5Ke1EYL55DdkQ3woVJP7zrt';
                document.head.appendChild(c);
            } catch (e) {}
        }

        var interactionEvents = ['scroll', 'touchstart', 'mousemove', 'click', 'keydown'];
        function onUserActive() {
            interactionEvents.forEach(function(e) {
                window.removeEventListener(e, onUserActive, { passive: true });
            });
            initTrackingAndChat();
        }
        interactionEvents.forEach(function(e) {
            window.addEventListener(e, onUserActive, { passive: true, once: true });
        });

        // Background idle fallback after page loads
        if (typeof window.requestIdleCallback === 'function') {
            window.addEventListener('load', function() {
                window.requestIdleCallback(initTrackingAndChat, { timeout: 3500 });
            }, { once: true });
        } else {
            window.addEventListener('load', function() {
                setTimeout(initTrackingAndChat, 2500);
            }, { once: true });
        }
    </script>

</head>

<body>
    <!-- Link pular para o conteúdo -->
    <a href="#main-content" class="visually-hidden-focusable btn btn-primary position-absolute top-0 start-0 m-2" style="z-index: 99999;">Skip to main content</a>

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe title="Google Tag Manager" src="https://www.googletagmanager.com/ns.html?id=GTM-N64XLKBT" height="0" width="0"
            style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager -->

    <HeaderLive activePage={activePage} />

    <main id="main-content">
        <slot />
    </main>

    <FooterLive />

    <!-- Início Scripts -->
    <script is:inline defer src="/js/bootstrap.bundle.min.js"></script>
    <script is:inline defer src="/js/site.js"></script>

    {carousel && (
    <>
        <script is:inline defer src="/js/jquery-3.6.4.min.js"></script>
        <script is:inline defer src="/lib/owlcarousel/owl.carousel.min.js"></script>
        <script is:inline defer src="/js/carousels.js"></script>
    </>
    )}


    <!-- Theme Toggle Handler -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtns = document.querySelectorAll('.js-theme-toggle');
            toggleBtns.forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                    if (isDark) {
                        document.documentElement.removeAttribute('data-theme');
                        localStorage.setItem('op_theme', 'light');
                    } else {
                        document.documentElement.setAttribute('data-theme', 'dark');
                        localStorage.setItem('op_theme', 'dark');
                    }
                });
            });
        });
    </script>

</body>

</html>
