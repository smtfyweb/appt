---
import LayoutLive from '../layouts/LayoutLive.astro';
import { getHousePainterSchema, getBreadcrumbSchema } from '../utils/schema';

const housePainterSchema = getHousePainterSchema();
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://www.opportunity-painting.com/" },
  { name: "RESOURCES", url: "https://www.opportunity-painting.com/404.html" },
  { name: "404 Error", url: "https://www.opportunity-painting.com/404.html" }
]);
---

<LayoutLive
  title="Page Not Found | Opportunity Painting"
  description="Sorry, the page you are looking for does not exist. With over 15 years of experience, Opportunity Painting Inc. specializes in high-quality commercial and residential painting and renovation services in Holliston, MA. For inquiries, contact us at +1 (508) 215-9441."
  canonical="https://www.opportunity-painting.com/404.html"
  keywords="Interior painting, Exterior painting, Commercial painting, Light carpentry, Kitchen cabinets refinishing"
  ogTitle="Page Not Found | Opportunity Painting"
  ogDescription="Sorry, the page you are looking for does not exist. With over 15 years of experience, Opportunity Painting Inc. specializes in high-quality commercial and residential painting and renovation services in Holliston, MA. For inquiries, contact us at +1 (508) 215-9441."
  ogUrl="https://www.opportunity-painting.com/404.html"
  ogImage="https://www.opportunity-painting.com/img/icons/icon-1.png"
  robots="noindex, nofollow"
  chat={false}
>
  <Fragment slot="jsonld">
    <!-- Início Script JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(housePainterSchema, null, 2)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
    <!-- Fim Script JSON-LD -->
  </Fragment>

    <!-- Início Cabeçalho da Página -->
    <div class="wow fadeIn container-fluid mb-5 page-header py-5" data-wow-delay="0.1s">
        <div class="container py-5">
            <h1 class="display-1 animated slideInDown text-white">404 Error</h1>

            <!-- Início Navegação Breadcrumb -->
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="mb-0 breadcrumb text-uppercase">
                    <li class="breadcrumb-item">
                        <a href="/" class="text-white">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="#" class="text-white">RESOURCES</a>
                    </li>
                    <li class="text-primary active breadcrumb-item" aria-current="page">404 Error</li>
                </ol>
            </nav>
            <!-- Fim Navegação Breadcrumb -->
        </div>
    </div>
    <!-- Fim Cabeçalho da Página -->

    <!-- Início Seção de Conteúdo 404 -->
    <div class="wow py-5 container-xxl fadeInUp" data-wow-delay="0.1s">
        <div class="container text-center">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <svg class="icon text-primary display-1" aria-hidden="true"><use href="/img/icons.svg#bi-exclamation-triangle"/></svg>
                    <div class="display-1 h1">404</div>
                    <h2 class="mb-4">Page Not Found</h2>
                    <p class="mb-4">We’re sorry, the page you have looked for does not exist in our website! Maybe go to
                        our home page or try to use a search?</p>

                    <!-- Início Botão de Retorno -->
                    <a href="/" class="btn btn-primary px-5 py-3">Go Back To Home</a>
                    <!-- Fim Botão de Retorno -->
                </div>
            </div>
        </div>
    </div>
    <!-- Fim Seção de Conteúdo 404 -->
</LayoutLive>
