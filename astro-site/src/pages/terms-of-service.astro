---
import LayoutLive from '../layouts/LayoutLive.astro';
import { getHousePainterSchema, getBreadcrumbSchema } from '../utils/schema';

const housePainterSchema = getHousePainterSchema();
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://www.opportunity-painting.com/" },
  { name: "RESOURCES", url: "https://www.opportunity-painting.com/terms-of-service.html" },
  { name: "Terms of Service", url: "https://www.opportunity-painting.com/terms-of-service.html" }
]);
---

<LayoutLive
  title="Terms of Service | Opportunity Painting & Renovation Services Inc. - Holliston, MA"
  description="Terms of Service for Opportunity Painting & Renovation Services Inc. website and residential remodeling estimates in Holliston, Massachusetts."
  canonical="https://www.opportunity-painting.com/terms-of-service.html"
  keywords="Kitchen renovation, Bathroom renovation, Basement finishing, Interior painting, Exterior painting, Commercial painting, Light carpentry, Kitchen cabinets refinishing"
  ogTitle="Terms of Service | Opportunity Painting & Renovation Services Inc. - Holliston, MA"
  ogDescription="Terms of Service for Opportunity Painting & Renovation Services Inc. website and residential remodeling estimates in Holliston, Massachusetts."
  ogUrl="https://www.opportunity-painting.com/terms-of-service.html"
  ogImage="https://www.opportunity-painting.com/img/carousel-3.jpg"
  chat={false}
  activePage="terms-of-service"
>
  <Fragment slot="jsonld">
    <!-- Início JSON-LD Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(housePainterSchema, null, 2)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
    <!-- Fim JSON-LD Schema -->
  </Fragment>

    <!-- Sober Document Header -->
    <div class="legal-header py-5">
        <div class="container text-center">
            <span class="legal-badge mb-2">Legal Agreement</span>
            <h1 class="text-white display-4 mb-2">Terms of Service</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center text-uppercase mb-0 small">
                    <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
                    <li class="breadcrumb-item"><span class="text-white-50">Resources</span></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Terms of Service</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Sober Document Container -->
    <div class="container py-5">
        <div class="legal-doc-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap pb-3 mb-4 border-bottom">
                <div>
                    <h2 class="h5 text-dark m-0 border-0 p-0">Opportunity Painting &amp; Renovation Services Inc.</h2>
                    <small class="text-muted">7 Franklin St, Holliston, MA 01746 &bull; (508) 215-9441</small>
                </div>
                <div class="text-end mt-2 mt-sm-0">
                    <span class="badge bg-light text-dark border px-3 py-2">Last Updated: October 2026</span>
                </div>
            </div>

            <p class="lead" style="font-size: 1.05rem; line-height: 1.8;">
                Please review the following terms and conditions governing your access to and use of our website and residential remodeling services. By accessing or using the website at <a href="/">opportunity-painting.com</a> (the “Site”), you agree to be bound by these Terms of Service (“Terms”) and all applicable laws of the Commonwealth of Massachusetts and the United States.
            </p>

            <h2>1. Terms of Use &amp; Eligibility</h2>
            <h3>1.1 Eligibility</h3>
            <p>
                You must be at least 18 years of age and legally capable of entering into binding contracts under Massachusetts law to use this Site or submit binding project inquiries.
            </p>

            <h3>1.2 Use License</h3>
            <p>
                Permission is granted to temporarily download one copy of the materials (information or software) on Opportunity Painting &amp; Renovation Services Inc.'s website for personal, non-commercial transitory viewing only. This is the grant of a licence, not a transfer of title, and under this licence you may not:
            </p>
            <ol>
                <li>Modify or copy the materials;</li>
                <li>Use the materials for any commercial purpose, or for any public display (commercial or non-commercial);</li>
                <li>Attempt to decompile or reverse engineer any software contained on Opportunity Painting &amp; Renovation Services Inc.'s website;</li>
                <li>Remove any copyright or other proprietary notations from the materials; or</li>
                <li>Transfer the materials to another person or 'mirror' the materials on any other server.</li>
            </ol>
            <p>
                This licence shall automatically terminate if you violate any of these restrictions and may be terminated by Opportunity Painting &amp; Renovation Services Inc. at any time. Upon terminating your viewing of these materials or upon the termination of this licence, you must destroy any downloaded materials in your possession whether in electronic or printed format.
            </p>

            <h2>2. Estimates, Proposals &amp; Contracting</h2>
            <h3>2.1 Estimates &amp; Scopes of Work</h3>
            <p>
                Quotations, scopes of work, and timelines provided via the website or subsequent on-site visits are estimates subject to formal written contract execution. Specific contract clauses, payment schedules, and project change orders will be detailed in individual Massachusetts Home Improvement Contractor agreements before work commences.
            </p>

            <h3>2.2 Standard of Care</h3>
            <p>
                Opportunity Painting &amp; Renovation Services Inc. warrants that all services will be performed by qualified personnel who possess the necessary competency in accordance with applicable industry standards, manufacturer specifications, and Massachusetts state building codes.
            </p>

            <h3>2.3 Licensing &amp; Insurance Verification</h3>
            <p>
                Opportunity Painting &amp; Renovation Services Inc. is fully insured with $2,000,000 General Liability and $1,000,000 Worker's Compensation insurance. Owner Juliney Santana holds an active Massachusetts Construction Supervisor License (CSL) and Home Improvement Contractor (HIC) registration. A certified Certificate of Insurance (COI) will be furnished to the property owner prior to work commencement.
            </p>

            <h2>3. Disclaimers &amp; Limitations of Liability</h2>
            <h3>3.1 Disclaimer of Website Warranties</h3>
            <p>
                The materials on Opportunity Painting &amp; Renovation Services Inc.'s website are provided on an 'as is' basis. Opportunity Painting &amp; Renovation Services Inc. makes no warranties, expressed or implied, and hereby disclaims and negates all other warranties including, without limitation, implied warranties or conditions of merchantability, fitness for a particular purpose, or non-infringement of intellectual property or other violation of rights. Actual craftsmanship warranties on painting and remodeling work are governed exclusively by our written project contract.
            </p>

            <h3>3.2 Limitation of Damages</h3>
            <p>
                In no event shall Opportunity Painting &amp; Renovation Services Inc. or its suppliers be liable for any damages (including, without limitation, damages for loss of data or profit, or due to business interruption) arising out of the use or inability to use the materials on Opportunity Painting &amp; Renovation Services Inc.'s website, even if Opportunity Painting &amp; Renovation Services Inc. or an authorized representative has been notified orally or in writing of the possibility of such damage.
            </p>

            <h3>3.3 Accuracy of Materials &amp; External Links</h3>
            <p>
                The materials appearing on Opportunity Painting &amp; Renovation Services Inc.'s website could include technical, typographical, or photographic errors. Opportunity Painting &amp; Renovation Services Inc. does not warrant that any of the materials on its website are accurate, complete, or current. Opportunity Painting &amp; Renovation Services Inc. may make changes to materials at any time without notice. Furthermore, Opportunity Painting &amp; Renovation Services Inc. has not reviewed all linked sites and is not responsible for the contents of any external linked site.
            </p>

            <h2>4. Governing Law &amp; Jurisdiction</h2>
            <p>
                These Terms of Service are governed by and construed in accordance with the laws of the Commonwealth of Massachusetts and the United States, without giving effect to any principles of conflicts of law. You irrevocably submit to the exclusive jurisdiction of the state and federal courts located in the Commonwealth of Massachusetts.
            </p>

            <!-- Official Document Footer -->
            <div class="legal-doc-footer">
                <h4 class="h6 text-uppercase text-muted mb-2 font-monospace" style="letter-spacing: 1px;">Official Company Contact</h4>
                <p class="mb-1"><strong>Opportunity Painting &amp; Renovation Services Inc.</strong></p>
                <p class="mb-1 text-muted">7 Franklin St, Holliston, MA 01746, USA</p>
                <p class="mb-1 text-muted">Phone: <a href="tel:+15082159441" class="text-primary font-weight-bold">(508) 215-9441</a> &bull; Email: <a href="mailto:office@opportunity-painting.com" class="text-primary">office@opportunity-painting.com</a></p>
                <p class="small text-muted mt-3 mb-0">MA CSL Licensed &bull; MA HIC Registered &bull; EPA Lead-Safe Certified &bull; Fully Insured</p>
            </div>
        </div>
    </div>
</LayoutLive>
