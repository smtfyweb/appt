---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import FAQ from '../../components/FAQ.astro';

const paintingFaqs = [
  {
    question: "What paint brands and finishes do you recommend for New England homes?",
    answer: "We primarily apply Benjamin Moore (Aura, Regal Select) and Sherwin-Williams (Emerald, Duration). For interior walls, we recommend matte or eggshell; for trim, doors, and cabinets, satin or semi-gloss; and for exterior wood siding, low-lustre exterior acrylic latex."
  },
  {
    question: "Do you repair drywall cracks, nail pops, and peeling paint before painting?",
    answer: "Yes, comprehensive surface preparation is included in every estimate. We scrape loose paint, feather-sand edges, patch drywall imperfections, re-tape joints, and apply stain-blocking primer before applying any topcoats."
  },
  {
    question: "What is your exterior painting season in Massachusetts?",
    answer: "Exterior painting in Massachusetts generally runs from late April through early November, depending on ambient daytime temperatures and humidity. We ensure substrates are thoroughly moisture-tested before applying exterior finishes."
  }
];

const paintingServices = [
  {
    title: "Interior Painting",
    image: "/img/carousel-1.jpg",
    link: "/service-interior-painting.html",
    description: "Flawless walls, ceilings, doors, and trim. We protect your furnishings, repair drywall, and produce razor-sharp paint lines.",
    features: ["Dust-Controlled Sanding", "Trim, Baseboard & Door Enamels", "Zero/Low VOC Paints"]
  },
  {
    title: "Exterior Painting & Staining",
    image: "/img/service-2.jpg",
    link: "/service-exterior-painting.html",
    description: "Weather-resistant exterior protection for cedar clapboards, shingles, trim, decks, and porches. Power washing and rot repair included.",
    features: ["Pressure Washing & Scraping", "Wood Rot & Carpentry Repairs", "Multi-Coat Weather Barrier"]
  },
  {
    title: "Commercial Painting",
    image: "/img/service-3.jpg",
    link: "/service-commercial-painting.html",
    description: "Office buildings, retail stores, property management, and educational facilities. Flexible scheduling to minimize business downtime.",
    features: ["Off-Hours Scheduling", "Durable Commercial Coatings", "Full Safety & Liability Compliance"]
  },
  {
    title: "Light Carpentry & Rot Repair",
    image: "/img/service-4.jpg",
    link: "/service-light-carpentry.html",
    description: "Replacing rotted exterior fascia, corner boards, window sills, and installing elegant interior trim before paint is applied.",
    features: ["PVC & Cedar Trim Replacement", "Crown Molding & Wainscoting", "Seamless Paint-Ready Fit"]
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://www.opportunity-painting.com/" },
  { name: "Services", url: "/interior-exterior-painting.html" }
];
---

<Layout
  title="Interior & Exterior Painting Contractors | Opportunity Painting Inc. - Holliston, MA"
  description="Master residential and commercial painting in Holliston & MetroWest MA. Interior walls, ceilings, trim, and exterior weather-shield painting. Call (508) 215-9441 for a free estimate."
  serviceName="Interior and Exterior Painting"
  serviceDescription="Professional residential and commercial painting services in Massachusetts, specializing in drywall prep, fine trim enameling, exterior weatherproofing, and stain finishes."
  faqs={paintingFaqs}
  breadcrumbs={breadcrumbs}
>
  <!-- Page Header -->
  <section class="page-header py-5 bg-dark text-white position-relative">
    <div class="container py-4">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <span class="badge-service">MASTER PAINTERS IN HOLLISTON, MA</span>
          <h1 class="text-white mb-3" style="font-size: 3.2rem;">
            Interior &amp; Exterior Painting Excellence Across MetroWest MA
          </h1>
          <p class="text-light mb-4" style="font-size: 1.1rem;">
            A fresh coat of paint does more than enhance color—it preserves your home's structural surfaces against age and New England weather. We provide clean, sharp, long-lasting paint finishes.
          </p>
          <div class="d-flex gap-3 flex-wrap">
            <a href="#quote-section" class="btn btn-primary btn-lg">Request Free Painting Estimate</a>
            <a href="tel:+15082159441" class="btn btn-outline-light btn-lg">(508) 215-9441</a>
          </div>
        </div>
        <div class="col-lg-5 mt-4 mt-lg-0">
          <img 
            src="/img/service-2.jpg" 
            alt="Expert painter applying exterior paint on Massachusetts home" 
            width="500" 
            height="340" 
            class="rounded shadow-lg w-100" 
            style="object-fit: cover;" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-5">
    <div class="container py-4">
      <div class="text-center mb-5">
        <span class="badge-service">PAINTING SPECIALTIES</span>
        <h2>Explore Our Full Range of Painting Services</h2>
        <p class="text-muted mx-auto" style="max-width: 650px;">
          Select a dedicated service below to explore our specific preparation techniques, coatings, and scope.
        </p>
      </div>

      <div class="row g-4">
        {paintingServices.map((srv) => (
          <div class="col-md-6">
            <ServiceCard {...srv} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote Section -->
  <section id="quote-section" class="py-5 bg-light">
    <div class="container py-3">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <QuoteForm 
            title="Request a Free Painting Estimate" 
            subtitle="Let's inspect your home's surfaces and provide a written proposal."
            defaultService="Interior Painting"
          />
        </div>
      </div>
    </div>
  </section>

  <FAQ items={paintingFaqs} />
</Layout>
