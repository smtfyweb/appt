                <div class="owl-carousel-inner">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-10 col-lg-8">
                                <h1 class="display-1 text-white">House Painters in Holliston, MA</h1>
                                <p class="mb-4 fs-5 fw-medium pb-3 text-white">
                                    Transform your spaces with elegance. Our interior painting experts craft unique
                                    environments that tell your story.
                                </p>
                                <a href="/service-interior-painting.html"
                                    class="btn btn-primary py-3 px-5">Read More<span class="visually-hidden"> about interior painting services</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Fim do Item do Carrossel 1 -->

            <!-- Início do Item do Carrossel 2 -->
            <div class="owl-carousel-item position-relative" data-dot="<img width='60' height='60' src='/img/carousel-1-thumb.webp' alt='Timeless Exterior Painting'>">
                <img width="1920" height="1080" alt="Timeless Exterior Painting" class="img-fluid" src="/img/carousel-1.jpg.webp" loading="lazy" decoding="async">
                <div class="owl-carousel-inner">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-10 col-lg-8">
                                <div class="h1 animated display-1 slideInDown text-white">Timeless Exteriors</div>
                                <p class="mb-4 fs-5 fw-medium pb-3 text-white">
                                    Enhance your exteriors with timeless allure. Our meticulous exterior painting
                                    process
                                    ensures lasting satisfaction, crafting spaces for years of comfortable living.
                                </p>
                                <a href="/service-exterior-painting.html"
                                    class="btn btn-primary py-3 animated px-5 slideInLeft">Read More<span class="visually-hidden"> about exterior painting services</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Fim do Item do Carrossel 2 -->

