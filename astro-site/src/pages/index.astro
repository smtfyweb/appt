                <div class="owl-carousel-inner">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-10 col-lg-8">
                                <div class="h1 animated display-1 slideInDown text-white">Complete Home Renovations</div>
                                <p class="mb-4 fs-5 fw-medium pb-3 text-white">
