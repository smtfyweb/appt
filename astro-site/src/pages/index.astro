---
import LayoutLive from '../layouts/LayoutLive.astro';
import { getHousePainterSchema } from '../utils/schema';

const housePainterSchema = getHousePainterSchema();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<LayoutLive
  title="House Painters &amp; Renovation Contractors | Opportunity Painting &amp; Renovation Services Inc. - Holliston, MA"
  description="Painting, cabinet refinishing, carpentry and home renovation in Holliston, MA, serving Framingham, Hopkinton, Milford, Medway and nearby towns. Free estimates."
  canonical="https://www.opportunity-painting.com/"
  keywords="Interior painting, Exterior painting, Commercial painting, Kitchen cabinets refinishing, Light carpentry, Kitchen renovation, Bathroom renovation, Basement renovation"
  ogTitle="House Painters &amp; Renovation Contractors | Opportunity Painting &amp; Renovation Services Inc. - Holliston, MA"
  ogDescription="Painting, cabinet refinishing, carpentry and home renovation in Holliston, MA, serving Framingham, Hopkinton, Milford, Medway and nearby towns. Free estimates."
  ogUrl="https://www.opportunity-painting.com/"
  ogImage="https://www.opportunity-painting.com/img/carousel-3.jpg"
  chat={true}
  carousel={true}
  activePage="home"
>
  <Fragment slot="jsonld">
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(housePainterSchema, null, 2)} />
  </Fragment>

    <!-- Início do Carrossel de Cabeçalho -->
