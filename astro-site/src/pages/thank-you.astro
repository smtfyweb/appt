---
import LayoutLive from '../layouts/LayoutLive.astro';
import { getHousePainterSchema, getBreadcrumbSchema } from '../utils/schema';

const housePainterSchema = getHousePainterSchema();
const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://www.opportunity-painting.com/" },
  { name: "RESOURCES", url: "https://www.opportunity-painting.com/thank-you.html" },
  { name: "Thank You", url: "https://www.opportunity-painting.com/thank-you.html" }
]);
---

<LayoutLive
  title="Thank You | Opportunity Painting & Renovation Services Inc."
  description="Thank you for reaching out to Opportunity Painting & Renovation Services Inc. Our team will get back to you as soon as possible. For any immediate assistance, please call us at 508 215 9441 or email us at office@opportunity-painting.com."
  canonical="https://www.opportunity-painting.com/thank-you.html"
  keywords="Interior painting, Exterior painting, Commercial painting, Light carpentry, Kitchen cabinets refinishing, Kitchen renovation, Bathroom renovation, Basement renovation"
  ogTitle="Thank You | Opportunity Painting & Renovation Services Inc."
  ogDescription="Thank you for reaching out to Opportunity Painting & Renovation Services Inc. Our team will get back to you as soon as possible. For any immediate assistance, please call us at 508 215 9441 or email us at office@opportunity-painting.com."
  ogUrl="https://www.opportunity-painting.com/thank-you.html"
  ogImage="https://www.opportunity-painting.com/img/carousel-3.jpg"
  robots="noindex, follow"
  chat={true}
>
  <Fragment slot="jsonld">
    <!-- Dados estruturados -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(housePainterSchema, null, 2)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema, null, 2)} />
  </Fragment>

    <!-- Início Cabeçalho da Página -->
    <div class="wow fadeIn container-fluid mb-5 page-header py-5" data-wow-delay="0.1s">
        <div class="container py-5">
            <h1 class="display-1 animated slideInDown text-white">Thank You!</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="mb-0 breadcrumb text-uppercase">
                    <li class="breadcrumb-item">
                        <a href="/" class="text-white">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="#" class="text-white">RESOURCES</a>
                    </li>
                    <li class="text-primary active breadcrumb-item" aria-current="page">Thank You</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Fim Cabeçalho da Página -->

    <!-- Início Seção de Agradecimento -->
    <div class="wow py-5 container-xxl fadeInUp" data-wow-delay="0.1s">
        <div class="container text-center">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <svg class="icon text-primary display-1" aria-hidden="true"><use href="/img/icons.svg#bi-check-circle"/></svg>
                    <div class="display-1 h1">Thank You!</div>
                    <h2 class="mb-4">We appreciate your inquiry.</h2>
                    <p class="mb-4">
                        Our team at Opportunity Painting &amp; Renovation Services Inc. will get back to you as soon as possible.
                        For immediate assistance, please call us at
                        <a href="tel:+15082159441" class="text-primary">508 215 9441</a>
                        or email us at
                        <a href="mailto:office@opportunity-painting.com"
                            class="text-primary">office@opportunity-painting.com</a>.
                    </p>
                    <a href="/" class="btn btn-primary px-5 py-3">Go Back To Home</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Fim Seção de Agradecimento -->
</LayoutLive>
