                <div class="d-flex pt-2">
                    <a href="http://www.instagram.com/opportunity_painting" target="_blank" rel="noopener noreferrer"
                        class="btn btn-outline-body btn-square me-1" aria-label="Instagram"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#fa-instagram"/></svg></a>
                    <a href="https://www.facebook.com/profile.php?id=100050506784663" target="_blank" rel="noopener noreferrer"
                        class="btn btn-outline-body btn-square me-1" aria-label="Facebook"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#fa-facebook-f"/></svg></a>
                    <a href="https://www.google.com/search?q=opportunity+painting+reviews&rlz=1CDGOYI_enUS777US777&oq=opportunity+painting+reviews&aqs=chrome..69i57j0i546l5.954j0j4&hl=en-US&sourceid=chrome-mobile&ie=UTF-8#lkt=LocalPoiReviews&lpg=cid:CgIgAQ%3D%3D&trex=m_t:lcl_akp,rc_f" target="_blank" rel="noopener noreferrer"
                        class="btn btn-outline-body btn-square me-1" aria-label="Google Reviews"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#fa-google"/></svg></a>
                    <a href="http://yelp.com/biz/opportunity-painting-holliston-3?hrid=FUbnm0Mtc4LOxRuI0VStiA&utm_campaign=bizapp_ios_review_share_popup&utm_medium=copy_link&utm_source=(direct)" target="_blank" rel="noopener noreferrer"
                        class="btn btn-outline-body btn-square me-1" aria-label="Yelp"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#fa-yelp"/></svg></a>
                    <a href="https://wa.me/message/K3QVFUZOUZVXO1" target="_blank" rel="noopener noreferrer"
                        class="btn btn-outline-body btn-square me-1" aria-label="WhatsApp"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#fa-whatsapp"/></svg></a>
                    <a href="https://www.youtube.com/channel/UC4Asa7w8FHFXJ0NzoZ4Xpyg" target="_blank" rel="noopener noreferrer"
