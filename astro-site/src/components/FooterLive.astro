                <a href="/areas-we-serve.html" class="btn btn-link">Areas We Serve</a>
                <a href="/about.html" class="btn btn-link">About Us</a>
                <a href="/contact.html" class="btn btn-link">Contact Us</a>
                <a href="/#services" class="btn btn-link">Our Services</a>
                <a href="/terms-of-service.html" class="btn btn-link">Terms &amp; Condition</a>
                <a href="/contact.html" class="btn btn-link">Support</a>
            </div>
            <!-- Fim Coluna Links Rápidos -->

            <!-- Início Coluna Newsletter -->
            <div class="col-md-6 col-lg-3">
                <h3 class="mb-4 text-light">Newsletter</h3>
                <p>For expert insights and industry news, subscribe to our newsletter.</p>
                <div class="position-relative mx-auto" style="max-width:400px;">
                    <input type="email" class="form-control bg-transparent pe-5 ps-4 py-3 w-100" placeholder="Your email" aria-label="Your email">
                    <button class="btn btn-primary py-2 end-0 me-2 mt-2 position-absolute top-0"
                        type="button">SignUp</button>
                </div>
            </div>
            <!-- Fim Coluna Newsletter -->

