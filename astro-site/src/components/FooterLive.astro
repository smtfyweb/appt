---
// FooterLive.astro - Fiel ao live/index.html com links sociais reais do topbar e crédito Smartify ADs
import { siteConfig } from '../siteConfig';
const credentials = siteConfig.credentials;
---

<!-- Início Seção Footer -->
<div class="wow fadeIn bg-dark container-fluid footer mt-5 pt-5 px-0 text-body" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="row g-5">

            <!-- Início Coluna Endereço -->
            <div class="col-md-6 col-lg-3">
                <h3 class="mb-4 text-light">Address</h3>
                <p class="mb-2"><svg class="icon text-primary me-3" aria-hidden="true"><use href="/img/icons.svg#fa-map-marker-alt"/></svg>7 Franklin St, Holliston, MA 01746, United States</p>
                <p class="mb-2 d-flex align-items-center flex-wrap">
                    <svg class="icon text-primary me-3" aria-hidden="true"><use href="/img/icons.svg#fa-phone-alt"/></svg>
                    <a href="tel:+15082159441" class="text-body text-decoration-none me-2">508 215 9441</a>
                    <a href="sms:+15082159441?&body=Hi%20Ney,%20I'd%20like%20to%20request%20a%20free%20quote" 
                       class="btn btn-outline-light d-inline-flex align-items-center justify-content-center text-center py-1 px-2" 
                       style="border-color: rgba(255, 255, 255, 0.3); font-size: 0.78rem; line-height: 1.2; border-radius: 4px;" 
                       title="Send a text message directly to Ney">Text US</a>
