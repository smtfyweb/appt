            </div>
            <div class="text-center col-md-4 text-md-end">
                Developed By <a href="https://www.smtfyads.com" target="_blank" rel="noopener noreferrer">Smartify ADs</a>
            </div>
        </div>
    </div>
</div>
<!-- Fim Copyright -->

<!-- Início Back to Top Button -->
<a href="#" class="btn btn-primary back-to-top btn-lg btn-lg-square" aria-label="Back to top">
