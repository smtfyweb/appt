---
export interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  { name: "Home", href: "/" },
  { name: "About Us", href: "/about.html" },
  {
    name: "Services",
    href: "/#services",
    children: [
      { name: "Kitchen Renovation", href: "/kitchen-renovation.html" },
      { name: "Bathroom Renovation", href: "/bathroom-renovation.html" },
      { name: "Basement Renovation", href: "/basement-renovation.html" },
      { name: "Kitchen Cabinet Refinishing", href: "/service-kitchen-cabinet-refinishing.html" },
      { name: "Interior Painting", href: "/service-interior-painting.html" },
      { name: "Exterior Painting", href: "/service-exterior-painting.html" },
      { name: "Commercial Painting", href: "/service-commercial-painting.html" },
      { name: "Light Carpentry", href: "/service-light-carpentry.html" }
    ]
  },
  { name: "Testimonials", href: "/testimonial.html" },
  { name: "Contact", href: "/contact.html" }
];
---

<!-- Site Header -->
<header class="site-header">
  <!-- Contact Topbar -->
  <div class="topbar bg-dark py-2">
    <div class="container d-flex justify-content-between align-items-center flex-wrap">
      <!-- Contact Info -->
      <div class="topbar-contact d-flex align-items-center flex-wrap">
