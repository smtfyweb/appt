        </div>
        <div class="col-md-4 text-center text-md-end text-muted" style="font-size: 0.85rem;">
          Developed By <a href="#" class="text-muted text-decoration-none">Smartify ADs</a>
        </div>
      </div>
    </div>
  </div>
</footer>
