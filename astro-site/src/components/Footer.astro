---
import { siteConfig } from '../siteConfig';

const currentYear = new Date().getFullYear();
const credentials = siteConfig.credentials;
const hasCredentials = Boolean(credentials.hic || credentials.csl || credentials.insured || credentials.epaLogo);
---

<footer class="site-footer bg-dark text-light pt-5">
  <div class="container py-5">
    <div class="row g-4">
      <!-- Company Column -->
      <div class="col-md-6 col-lg-3">
        <div class="d-flex align-items-center mb-3">
          <img src="/img/icons/icon-1.png" alt="Opportunity Painting Logo" width="40" height="40" class="me-2" />
          <h3 class="text-white m-0" style="font-size: 1.5rem;">OPPORTUNITY PAINTING</h3>
        </div>
        <p class="text-muted mb-4" style="font-size: 0.95rem;">
          Family-owned and operated in Holliston, MA. Backed by over 15 years of experience delivering premier interior &amp; exterior painting, cabinet refinishing, and complete home renovations across MetroWest Boston with uncompromising craftsmanship.
        </p>
        <div class="contact-items">
          <p class="mb-2 text-muted d-flex align-items-start">
            <svg class="me-2 mt-1 flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>7 Franklin St, Holliston, MA 01746, USA</span>
          </p>
