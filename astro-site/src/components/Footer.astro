      <!-- Services Column -->
      <div class="col-md-6 col-lg-3">
        <h3 class="mb-4 text-light" style="font-size: 1.3rem;">Services</h3>
        <ul style="list-style: none; padding: 0;">
          <li><a href="/bathroom-renovation.html" class="btn-link">Bathroom Renovation</a></li>
          <li><a href="/basement-renovation.html" class="btn-link">Basement Renovation</a></li>
          <li><a href="/kitchen-renovation.html" class="btn-link">Kitchen Renovation</a></li>
          <li><a href="/service-kitchen-cabinet-refinishing.html" class="btn-link">Kitchen Cabinet Refinishing</a></li>
          <li><a href="/service-interior-painting.html" class="btn-link">Interior Painting</a></li>
          <li><a href="/service-exterior-painting.html" class="btn-link">Exterior Painting</a></li>
          <li><a href="/service-commercial-painting.html" class="btn-link">Commercial Painting</a></li>
          <li><a href="/service-light-carpentry.html" class="btn-link">Light Carpentry</a></li>
        </ul>
