      <!-- Quick Links Column -->
      <div class="col-md-6 col-lg-3">
        <h3 class="mb-4 text-light" style="font-size: 1.3rem;">Quick Links</h3>
        <ul style="list-style: none; padding: 0;">
          <li><a href="/about.html" class="btn-link">About Us</a></li>
          <li><a href="/contact.html" class="btn-link">Contact Us</a></li>
          <li><a href="/" class="btn-link">Our Services</a></li>
          <li><a href="/terms-of-service.html" class="btn-link">Terms &amp; Condition</a></li>
          <li><a href="/sitemap.html" class="btn-link">Sitemap</a></li>
        </ul>
      </div>

      <!-- Newsletter Column (Restored identical to live/index.html) -->
      <div class="col-md-6 col-lg-3">
        <h3 class="mb-4 text-light" style="font-size: 1.3rem;">Newsletter</h3>
        <p class="text-muted" style="font-size: 0.9rem;">For expert insights and industry news, subscribe to our newsletter.</p>
        <div class="position-relative mx-auto" style="max-width: 400px;">
          <input class="form-control bg-transparent pe-5 ps-4 py-3 w-100 text-light" placeholder="Your email" type="email" style="border-color: rgba(255,255,255,0.2);">
          <button class="btn btn-primary py-2 end-0 me-2 mt-2 position-absolute top-0" type="button">SignUp</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Sub-Footer -->
  <div class="copyright py-3" style="background: #181818;">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-8 text-center text-md-start mb-2 mb-md-0">
